# Shared local configuration for every QuickPlot Vite app.
# Copy this file to `.env` and fill in your Firebase project values.

# Firebase Console > Project settings > Your apps > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Same-origin routes used by the landing page in development and production.
VITE_URL_2D=/2d/
VITE_URL_3D=/3d/

# Required only for cloud workspace storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
