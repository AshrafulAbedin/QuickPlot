# Shared local configuration for every QuickPlot Vite app.
# Copy this file to `code/.env` and fill it in once — all three apps read it.

# Sign-in: Firebase Console > Project settings > Your apps > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Workspace storage: Supabase Dashboard > Project Settings > API
# Use the bare project URL (https://<ref>.supabase.co), NOT the /rest/v1/ endpoint.
# The anon / publishable key is safe in the browser; never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Same-origin routes used by the landing page in development and production.
VITE_URL_2D=/2d/
VITE_URL_3D=/3d/
