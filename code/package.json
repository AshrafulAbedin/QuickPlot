{
  "name": "quickplot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @quickplot/landing --filter @quickplot/2d --filter @quickplot/3d --filter web dev",
    "dev:2d": "pnpm --filter @quickplot/2d dev",
    "dev:3d": "pnpm --filter @quickplot/3d dev",
    "dev:web": "pnpm --filter web dev",
    "dev:landing": "pnpm --filter @quickplot/landing dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
