{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@quickplot/types":    ["../../packages/types/src/index.ts"],
      "@quickplot/renderer": ["../../packages/renderer/src/index.ts"],
      "@quickplot/core":     ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src"]
}
