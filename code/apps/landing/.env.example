# Where the landing page sends visitors when they pick a grapher.
# Defaults below match the dev server ports of apps/2d and apps/3d.
# In production, set these to the deployed URLs.
VITE_URL_2D=http://localhost:5174
VITE_URL_3D=http://localhost:5175

# Google OAuth entry point (Neon-backed). Leave empty until the auth route
# exists — the Sign in / Register screens then show a "not connected yet"
# notice instead of navigating nowhere.
VITE_AUTH_URL=
