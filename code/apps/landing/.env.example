# Where the landing page sends visitors when they pick a grapher.
# Defaults below match the dev server ports of apps/2d and apps/3d.
# In production, set these to the deployed URLs.
VITE_URL_2D=/2d/
VITE_URL_3D=/3d/

# Firebase config for Google sign-in. Copy this file to `.env` and fill these
# values from Firebase Console > Project settings > Your apps > SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
