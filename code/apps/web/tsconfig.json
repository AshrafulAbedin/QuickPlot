{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@quickplot/core": ["../../packages/core/src/index.ts"],
      "@quickplot/renderer": ["../../packages/renderer/src/index.ts"],
      "@quickplot/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["src"]
}