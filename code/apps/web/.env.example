# Firebase web app config — copy this file to `.env` and fill in real values
# from Firebase console: Project settings > General > Your apps > SDK setup.
# All keys must be prefixed with VITE_ so Vite exposes them to the client.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
